# Copie este arquivo para ".env" (que o .gitignore já ignora) e preencha.
# Estes valores NÃO são usados pelo site. Servem só para scripts seus no computador
# (backup, limpeza do histórico etc.). O site em si não lê o .env.

# Senha do banco (Supabase > Project Settings > Database)
SUPABASE_DB_PASSWORD=

# Chave de administrador. Dá acesso total e ignora as regras de segurança.
# NUNCA coloque no index.html nem em nada que vá para o navegador.
SUPABASE_SERVICE_ROLE_KEY=
