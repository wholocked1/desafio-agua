# ==========================================================
#  Desafio da Água: modelo do arquivo .env
# ==========================================================
# Como usar:
#   1. Copie este arquivo e renomeie a cópia para ".env" (com o ponto, sem ".example").
#   2. Preencha os valores SÓ no .env, no seu computador.
#   3. Confira que o arquivo ".gitignore" (com o "i") tem a linha ".env",
#      para o .env NUNCA ir para o GitHub.
#
# Este .env é só o seu "cofre" local, para não perder as senhas.
# O app NÃO lê este arquivo. Onde cada valor é usado de verdade está anotado ao lado.
# Este modelo (.env.example) pode ir para o GitHub, porque não tem nenhum valor.

# ---------- Supabase ----------
# Project URL (público, também vai no config.js)
SUPABASE_URL=https://nwiqiaqeiwmvkylcjwrb.supabase.co

# Senha do banco. Não aparece no painel: só dá para criar uma nova
# (Database → Settings → Reset database password). O app não usa.
SUPABASE_DB_PASSWORD=IjBmKtiZrOXjJhAP

# Chave secret / service_role. Acesso total ao banco, ignora todas as regras.
# O app não usa; a função "notify" recebe a dela sozinha do Supabase.
# Só guarde aqui se for usar em algum script seu.
SUPABASE_SERVICE_ROLE_KEY=sb_secret_d7T9ewm_e51FaoliMyRyGw_7IW-0qNz

# ---------- Gmail do app (e-mails de resumo) ----------
# Usados nos Secrets da função: Edge Functions → Secrets
GMAIL_USER=desafiodaagua.app@gmail.com
GMAIL_APP_PASSWORD=jynk jpnc uwjj wxiv

# ---------- Notificações (gerar-chaves-vapid.html) ----------
# A pública também vai no config.js. A privada vai SÓ nos Secrets da função.
# Se perder a privada, terá que gerar um par novo e todos reativam os lembretes.
VAPID_PUBLIC_KEY=BBVhevWiQF2Yt2XzBkNkJbeeSkf7DzFAw4dAbWsJFLWKlVIm4VrBNFuhostPlbCUH_VpMjKhviHUNlMFId1Xpno
VAPID_PRIVATE_KEY=yzwP_ucNAP6ESMHQhUka3vUiV259iDBIqMXzPYl058s

# ---------- App ----------
